{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (desktop)",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-x:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "comment": "「文件」页一键打开接收文件夹（scope 只放行该目录）",
      "allow": [{ "path": "$APPDATA/lanfile" }]
    }
  ]
}
