{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vitrytool",
  "version": "0.2.2",
  "identifier": "com.sovly.vitrytool",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vitrytool",
        "width": 800,
        "height": 600
      },
      {
        "label": "quick-paste",
        "title": "VitryTool 快速粘贴",
        "url": "popup.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "width": 440,
        "height": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/tauri-plugin-clipboard-x/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
